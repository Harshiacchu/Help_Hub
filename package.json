{
  "name": "helphub",
  "version": "1.0.0",
  "description": "Multi-tenant service desk for customer support",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "service-desk",
    "multi-tenant",
    "support",
    "tickets"
  ],
  "authors": [
    "Abhinay Sharthi",
    "Emily Huang"
  ],
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "trailingComma": "es5",
    "endOfLine": "lf"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "mailparser": "^3.5.0",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
