{
  "name": "helphub",
  "version": "1.0.0",
  "description": "Multi-tenant service desk for customer support",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/scripts/seed.js",
    "prompts": "node server/scripts/load-prompts.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . \"!package-lock.json\"",
    "format:check": "prettier --check . \"!package-lock.json\""
  },
  "keywords": [
    "service-desk",
    "multi-tenant",
    "support",
    "tickets"
  ],
  "authors": [
    "Abhinay Sharthi",
    "Emily Huang"
  ],
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "trailingComma": "es5",
    "endOfLine": "lf"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
