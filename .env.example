# .env - Environment Variables for HelpHub
# 7-DAY SESSION & PASSWORD HASHING CONFIGURATION

# ============================================
# SESSION CONFIGURATION
# ============================================

# Session secret key (MUST change in production!)
# Use a strong random string (32+ characters)
SESSION_SECRET=change-this-to-a-strong-secret-key-in-production

# Node environment
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection URI
# Local development:
MONGODB_URI=mongodb://localhost:27017/helpHub

# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/helpHub

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Server URL (for email links, etc.)
SERVER_URL=http://localhost:3000

# ============================================
# EMAIL CONFIGURATION (For password reset, etc.)
# ============================================

# Email service (optional)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ============================================
# SECURITY (Production Only)
# ============================================

# Enable HTTPS in production
# HTTPS=true
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CERT_PATH=/path/to/cert.pem

# ============================================
# LOGGING
# ============================================

# Log level
# LOG_LEVEL=info

# ============================================
# NOTES
# ============================================

# 1. SESSION_SECRET:
#    - Must be a strong random string
#    - Change immediately in production
#    - Never commit to git
#    - Example: SESSION_SECRET=aB7xK2@mPq9#vL4$nY8%hG3^wC1&dF5
#
# 2. MONGODB_URI:
#    - Use local MongoDB for development
#    - Use MongoDB Atlas for production
#    - Include database name at end: /helpHub
#
# 3. NODE_ENV:
#    - development: disables secure flag for cookies
#    - production: enables secure flag (HTTPS only)
#
# 4. This file is IGNORED by git
#    - Create a copy in production server
#    - Store secrets securely
#    - Never commit to version control
